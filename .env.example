# Django Environment Variables Template
# Copy this file to .env and configure values for your environment.

# Django secret key (set a secure random string in production / Vercel dashboard)
DJANGO_SECRET_KEY=replace-with-a-secure-secret-key

# Set to False in production
DJANGO_DEBUG=False

# Allowed hosts (use your vercel deployment domain, e.g. .vercel.app)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1],.vercel.app
